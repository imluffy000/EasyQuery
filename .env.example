# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 32

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Control-plane database (the app's own, not a customer database) ---
DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev_password@localhost:5433/copilot
REDIS_URL=redis://localhost:6379/0

# --- Secrets (REQUIRED; startup fails in production if these are weak) ---
# ENCRYPTION_KEY protects stored customer-database passwords at rest.
# Rotating it without re-encrypting existing rows makes them unreadable.
ENCRYPTION_KEY=dev-encryption-key-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-in-production-32
# Optional: exact email promoted to EasyQuery superuser on next login.
ADMIN_EMAIL=

# --- Social login (optional; configure all three values for each provider) ---
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/oauth/github/callback

# --- Model ---
# This file is COMMITTED. Put the real key in .env (git-ignored), never here.
#
# LLM_PROVIDER: anthropic | openai | openrouter | echo
#   "echo" runs the full pipeline offline with no API key: SQL is still
#   validated and executed for real, only the model output is a placeholder.
#
# LLM_MODEL must use the provider's own naming:
#   anthropic   -> claude-sonnet-5
#   openai      -> gpt-4o
#   openrouter  -> anthropic/claude-sonnet-4.5   (vendor-prefixed slug)
#
# OpenRouter keys start with "sk-or-v1-". OpenRouter reports the real cost of
# each call, so analytics uses that instead of the local price table.
LLM_PROVIDER=echo
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# --- HTTP ---
# Comma-separated. A wildcard is rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# --- Query guardrails (ceilings; a workspace may tighten, never widen) ---
QUERY__MAX_EXECUTION_TIME_SECONDS=30
QUERY__MAX_ROWS=10000
QUERY__MAX_JOINS=10
QUERY__COST_WARNING_THRESHOLD=1000000

# --- Observability ---
OTEL_ENDPOINT=http://localhost:4317
