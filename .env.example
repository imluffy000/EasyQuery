# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 32

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Control-plane database (the app's own, not a customer database) ---
DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev_password@localhost:5433/copilot
REDIS_URL=redis://localhost:6379/0

# --- Secrets (REQUIRED; startup fails in production if these are weak) ---
# ENCRYPTION_KEY protects stored customer-database passwords at rest.
# Rotating it without re-encrypting existing rows makes them unreadable.
ENCRYPTION_KEY=dev-encryption-key-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-in-production-32

# --- Model ---
# "echo" runs the full pipeline offline with no API key: SQL is still
# validated and executed for real, only the model output is a placeholder.
LLM_PROVIDER=echo
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# --- HTTP ---
# Comma-separated. A wildcard is rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# --- Query guardrails (ceilings; a workspace may tighten, never widen) ---
QUERY__MAX_EXECUTION_TIME_SECONDS=30
QUERY__MAX_ROWS=10000
QUERY__MAX_JOINS=10
QUERY__COST_WARNING_THRESHOLD=1000000

# --- Observability ---
OTEL_ENDPOINT=http://localhost:4317
